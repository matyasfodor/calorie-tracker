// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Entry {
  id           Int      @id @default(autoincrement())
  timestamp    DateTime
  name         String
  calorieValue Int      @map("calorie_value")
  cheatMeal    Boolean  @default(false) @map("cheat_meal")
  owner        User     @relation(fields: [ownerId], references: [id])
  ownerId      Int
}

model User {
  id      Int      @id @default(autoincrement())
  name    String
  isAdmin Boolean  @map("is_admin")
  profile Profile?
  entries Entry[]
}

model Profile {
  id           Int @id @default(autoincrement())
  calorieLimit Int @default(2100) @map("calorie_limit")

  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique
}
